{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "ALVK Design System",
    "version": "1.0.0",
    "source": "ALVK_Brandbook.html",
    "note": "Tokens semânticos de contraste são extensões de interface documentadas em docs/accessibility.md."
  },
  "color": {
    "coral": {
      "sunrise": { "$value": "#FF8C42", "$type": "color" },
      "pop": { "$value": "#FF6B35", "$type": "color" },
      "blaze": { "$value": "#FF4D00", "$type": "color" },
      "ember": { "$value": "#E03D00", "$type": "color" }
    },
    "blue": {
      "sky": { "$value": "#00C2FF", "$type": "color" },
      "cloudy": { "$value": "#3397F0", "$type": "color" },
      "azure": { "$value": "#4386EA", "$type": "color" },
      "spectrum": { "$value": "#184BFF", "$type": "color" }
    },
    "neutral": {
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "snow": { "$value": "#FFFCFC", "$type": "color" },
      "shadow": { "$value": "#272727", "$type": "color" },
      "surface": { "$value": "#1C1C1C", "$type": "color" },
      "backgroundSubtle": { "$value": "#141414", "$type": "color" },
      "background": { "$value": "#0D0D0D", "$type": "color" },
      "border": { "$value": "#2A2A2A", "$type": "color" },
      "muted": { "$value": "#666666", "$type": "color" }
    },
    "semantic": {
      "contentPrimary": { "$value": "#FFFCFC", "$type": "color" },
      "contentSecondary": { "$value": "#A7A7A7", "$type": "color", "$description": "Extensão AA para texto secundário em fundo #0D0D0D" },
      "contentInverse": { "$value": "#0D0D0D", "$type": "color" },
      "focus": { "$value": "#00C2FF", "$type": "color" }
    }
  },
  "typography": {
    "family": { "sans": { "$value": ["Urbanist", "Avenir", "Montserrat", "Arial", "sans-serif"], "$type": "fontFamily" } },
    "weight": {
      "light": { "$value": 200, "$type": "fontWeight" },
      "book": { "$value": 300, "$type": "fontWeight" },
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" },
      "extrabold": { "$value": 800, "$type": "fontWeight" },
      "black": { "$value": 900, "$type": "fontWeight" }
    }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "15": { "$value": "60px", "$type": "dimension" }
  },
  "radius": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "xl": { "$value": "20px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  }
}
